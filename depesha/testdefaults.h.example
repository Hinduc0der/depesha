// Образец для src/testdefaults.h -- файла, который в репозиторий не попадает.
//
// Скопируйте его в src/testdefaults.h и впишите адрес и токен своего
// медиа-сервера (см. README, раздел про медиа-сервер). Тогда сборка подставит
// их при первом запуске, если поле в настройках пустое, и набирать адрес на
// телефоне не придётся. Введённое на телефоне руками не затирается.
//
// Без этого файла приложение работает ровно так же, только адрес нужно
// ввести в настройках самому -- или не вводить вовсе, см. README.

#ifndef TESTDEFAULTS_H
#define TESTDEFAULTS_H

#define KG_TEST_MEDIA_URL "http://192.0.2.1:8089/kg-media"
#define KG_TEST_MEDIA_TOKEN "вставьте-сюда-токен"

#endif // TESTDEFAULTS_H
